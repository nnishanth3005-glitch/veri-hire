rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidCandidate(data) {
      return data.keys().hasAll(['id', 'name', 'role', 'organization', 'status', 'overallAuthenticityScore']) &&
        data.id is string && data.id.size() <= 64 &&
        data.name is string && data.name.size() <= 128 &&
        data.role is string && data.role.size() <= 128 &&
        data.organization is string && data.organization.size() <= 128 &&
        data.status in ['authentic', 'synthetic_detected', 'under_review'] &&
        data.overallAuthenticityScore is number;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['action', 'examinerId']) &&
        data.action is string && data.action.size() <= 64 &&
        data.examinerId is string && data.examinerId.size() <= 128;
    }

    function isValidExaminer(data) {
      return data.keys().hasAll(['uid', 'email']) &&
        data.uid is string && data.uid.size() <= 128 &&
        data.email is string && data.email.size() <= 128;
    }

    // Test connection endpoint for initial boot validation
    match /test/{testId} {
      allow read: if true;
    }

    // Candidates forensic dossiers
    match /candidates/{candidateId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(candidateId) && isValidCandidate(incoming());
      allow update: if isSignedIn() && isValidId(candidateId) && isValidCandidate(incoming()) && incoming().id == existing().id;
      allow delete: if isSignedIn() && isValidId(candidateId);
    }

    // Immutable audit ledger logs
    match /audit_logs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(logId) && isValidAuditLog(incoming());
      allow update, delete: if false;
    }

    // Examiners profiles
    match /examiners/{examinerId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(examinerId) && (request.auth.uid == examinerId || request.auth.token.email == 'nnishanth3005@gmail.com') && isValidExaminer(incoming());
      allow delete: if false;
    }
  }
}
